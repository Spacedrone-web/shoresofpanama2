---
import Layout from '../../layouts/Layout.astro';
import parking from "../../assets/Floor_41.png";

const title = "Parking at Shores of Panama | Guest Parking Guide";
const description =
  "Complete parking guide for Shores of Panama guests in Panama City Beach. Find dedicated parking on the 4th floor, directions, tips, and everything you need for a smooth arrival.";
const canonicalUrl = "https://shoresofpanama.org/parking/";

const schemaMarkup = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://shoresofpanama.org/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Parking",
            "item": canonicalUrl
          }
        ]
      }
    },
    {
      "@type": "ParkingFacility",
      "name": "Shores of Panama Parking Garage",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "9900 S Thomas Dr",
        "addressLocality": "Panama City Beach",
        "addressRegion": "FL",
        "postalCode": "32408",
        "addressCountry": "US"
      },
      "description":
        "On-site covered parking garage at Shores of Panama Resort. Guest reserved spot on the 4th floor.",
      "url": canonicalUrl
    }
  ]
};
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />
  </Fragment>

  <section class="parking-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page">Parking</li>
        </ol>
      </nav>

      <h1>Parking at Shores of Panama</h1>
      <p class="hero-subtitle">
        After arriving and getting your packet at the portico, you will be able to enter the garage directly. 
        Everything you need to know about arriving, parking, and settling in—
        so you can get to the beach faster.
      </p>
    </div>
  </section>

  <section class="quick-ref" aria-label="Quick parking reference">
    <div class="container">
      <div class="quick-ref__grid">
        <div class="quick-ref__item">
          <span class="icon" aria-hidden="true">🛑</span>
          <strong>Your Spot</strong>
          <span>4th Floor – Dedicated Reserved Space</span>
        </div>
		<div class="quick-ref__item">
          <span class="icon" aria-hidden="true">🅿️</span>
          <strong>Garage limits</strong>
          <span>Max Height 6' 11", Length 18', Width 8' 6", no hitches or extensions</span>
        </div>
        <div class="quick-ref__item">
          <span class="icon" aria-hidden="true">🏢</span>
          <strong>Garage Location</strong>
          <span>On-site, attached to the resort</span>
        </div>
        <div class="quick-ref__item">
          <span class="icon" aria-hidden="true">🚗</span>
          <strong>Vehicles</strong>
          <span>1 vehicle per reserved space</span>
        </div>
        <div class="quick-ref__item">
          <span class="icon" aria-hidden="true">🕐</span>
          <strong>Access</strong>
          <span>24 hours / 7 days a week</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section parking-spot" id="your-spot">
    <div class="container">
      <h2>Your Dedicated Parking Spot</h2>
      <p>
        As a guest of unit 427, you have access to a <strong>dedicated, reserved
        parking space on the 4th floor</strong> of the Shores of Panama parking
        garage. This spot is assigned exclusively for your stay—no hunting for
        an open space when you arrive.
      </p>

      <div class="info-card">
        <h3>Spot Details</h3>
        <ul>
          <li><strong>Floor:</strong> 4th Floor</li>
          <li><strong>Type:</strong> Reserved / Dedicated</li>
          <li><strong>Access:</strong> Drive directly to Level 4</li>
          <li><strong>Height Clearance:</strong> Standard garage clearance</li>
          <li><strong>Additional Vehicles:</strong> One vehicle per reserved space</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section arrival-instructions" id="arrival">
    <div class="container">
      <h2>Step-by-Step Arrival Instructions</h2>
      <ol class="steps">
        <li>
          <span class="step-num">1</span>
          <div>
            <strong>Head to Shores of Panama Resort</strong>
            <p>Navigate to <strong>9900 S Thomas Dr, Panama City Beach, FL 32408</strong>.</p>
          </div>
        </li>
        <li>
          <span class="step-num">2</span>
          <div>
            <strong>Enter the portico right after the Parking Garage enterance</strong>
			<p>At this time you will be provided your RFID bands and parking pass</p>
          </div>
        </li>
        <li>
          <span class="step-num">3</span>
          <div>
            <strong>Proceed to the 4th Floor</strong>
            <p>Your dedicated spot will be marked.</p>
          </div>
        </li>
        <li>
          <span class="step-num">4</span>
          <div>
            <strong>Park and Head to the Unit</strong>
          </div>
        </li>
        <li>
          <span class="step-num">5</span>
          <div>
            <strong>Enjoy Your Stay!</strong>
            <p>Your car is safe and covered for your visit.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section parking-map" id="map">
    <div class="container">
      <h2>Parking Map</h2>
      <p>The map below shows the 4th-floor parking layout.</p>

      <img
        src={parking.src}
        alt="4th floor parking map showing the dedicated guest parking spot at Shores of Panama"
        class="parking-map__img"
      />

      <p class="map-caption">
        <em>Your dedicated spot is on the 4th floor.</em>
      </p>
    </div>
  </section>


  <!-- ======================================================
       TIPS & RULES
  ====================================================== -->
  <section class="section tips" id="tips">
    <div class="container">
      <h2>Parking Tips &amp; House Rules</h2>
      <div class="tips__grid">
        <div class="tip-card">
          <h3>✅ Do</h3>
          <ul>
            <li>Park only in your designated spot on the 4th floor</li>
            <li>Unload luggage at the resort entrance before parking</li>
            <li>Keep your vehicle within the painted lines</li>
            <li>Secure your vehicle—lock doors and windows</li>
            <li>Contact us immediately if your spot is occupied</li>
          </ul>
        </div>
        <div class="tip-card">
          <h3>🚫 Please Avoid</h3>
          <ul>
            <li>Parking in spots reserved for other units</li>
            <li>Leaving valuables visible in your vehicle</li>
            <li>Parking oversized vehicles without prior approval</li>
            <li>Blocking the garage ramp or fire lanes</li>
            <li>Allowing unauthorized vehicles to use your spot</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

	<!-- ======================================================
		 NEARBY PARKING
	====================================================== -->
	<section class="section nearby" id="nearby">
	  <div class="container">
		<h2>Need Extra Parking?</h2>

		<p>
		  If you have more than one vehicle, additional parking is located at 9941 Thomas Drive.
		</p>

		<section style="max-width: 900px; margin: auto; padding: 2rem;">
		  <h2>Offsite Parking</h2>

		  <h3>How to Pay to Park</h3>
		  <ol style="margin-top: 1rem; line-height: 1.6;">
			<li>
			  Pay for parking by using <strong>Passport Parking</strong> — a fast and convenient
			  way to pay without worrying about feeding meters.
			</li>
			<li>
			  Pay directly online at 
			  <a href="https://www.passportparking.com" target="_blank" rel="noopener noreferrer">
				passportparking.com
			  </a>
			  OR download the free Passport Parking app from the App Store or Google Play.
			</li>
			<li>Create an account and add your preferred payment method.</li>
			<li>Enter the parking zone number (displayed on signs in each lot).</li>
			<li>Enter your vehicle license plate number.</li>
			<li>Start your session and enjoy the beach!</li>
			<li>Extend your parking time remotely if needed.</li>
		  </ol>

		  <h3>Parking Rates</h3>
		  <ol style="margin-top: 1rem; line-height: 1.6;">
			<li>$2 per hour (up to 6 hours)</li>
			<li>$12 per day (24 hours)</li>
			<li>$84 per week</li>
		  </ol>
		</section>

	  </div>
	</section>

  <!-- ======================================================
       INTERNAL LINKS / CTA
  ====================================================== -->
  <section class="section cta-section">
    <div class="container">
      <h2>Ready to Plan Your Trip?</h2>
      <p>
        Now that parking is sorted, explore everything else Shores of Panama
        has to offer.
      </p>
      <div class="cta-links">
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href="/amenities/" class="btn btn--secondary">Explore Amenities</a>
        <a href="/local-guide/" class="btn btn--secondary">Local Area Guide</a>
        <a href="/contact/" class="btn btn--secondary">Contact Us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ====================================================
     BASE / LAYOUT
  ==================================================== */
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 4rem 0;
  }

  .section:nth-child(even) {
    background-color: #f7f9fc;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    color: #0a2540;
  }

  h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    color: #0a2540;
    margin-bottom: 1rem;
    border-bottom: 3px solid #0066cc;
    padding-bottom: 0.4rem;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0a2540;
    margin-bottom: 0.5rem;
  }

  p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #334155;
    margin-bottom: 1rem;
  }

  ul,
  ol {
    margin: 0 0 1.25rem 1.25rem;
    color: #334155;
    line-height: 1.8;
  }

  /* ====================================================
     BREADCRUMB
  ==================================================== */
  .breadcrumb ol {
    list-style: none;
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin: 0 0 1rem;
    padding: 0;
    font-size: 0.9rem;
    color: #64748b;
  }

  .breadcrumb a {
    color: #0066cc;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  /* ====================================================
     HERO
  ==================================================== */
  .parking-hero {
    background: linear-gradient(135deg, #0a2540 0%, #0066cc 100%);
    color: #fff;
    padding: 4rem 0 3rem;
  }

  .parking-hero h1 {
    color: #fff;
  }

  .parking-hero .breadcrumb ol {
    color: rgba(255, 255, 255, 0.75);
  }

  .parking-hero .breadcrumb a {
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.88);
    max-width: 620px;
    margin: 0;
  }

  /* ====================================================
     QUICK REFERENCE
  ==================================================== */
  .quick-ref {
    background: #0066cc;
    padding: 1.75rem 0;
  }

  .quick-ref__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
  }

  .quick-ref__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: #fff;
    gap: 0.25rem;
  }

  .quick-ref__item .icon {
    font-size: 1.75rem;
  }

  .quick-ref__item strong {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.85;
  }

  .quick-ref__item span:last-child {
    font-size: 1rem;
    font-weight: 600;
  }

  /* ====================================================
     INFO CARD
  ==================================================== */
  .info-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #0066cc;
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    margin-top: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .info-card ul {
    margin-bottom: 0;
  }

  /* ====================================================
     STEPS
  ==================================================== */
  .steps {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .steps li {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    min-width: 2.25rem;
    background: #0066cc;
    color: #fff;
    font-weight: 800;
    font-size: 1rem;
    border-radius: 50%;
  }

  .steps li > div p {
    margin: 0.25rem 0 0;
    font-size: 0.98rem;
  }

  /* ====================================================
     MAP PLACEHOLDER
  ==================================================== */
  .map-placeholder {
    background: #eef2f7;
    border: 2px dashed #aac4e0;
    border-radius: 12px;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1.5rem 0 1rem;
  }

  .map-placeholder__inner {
    text-align: center;
    color: #64748b;
  }

  .map-placeholder__inner span {
    font-size: 3rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .map-placeholder__inner p {
    margin: 0;
    color: #64748b;
    font-size: 1rem;
  }

  .map-note {
    font-size: 0.88rem !important;
    margin-top: 0.4rem !important;
  }

  .map-caption {
    font-size: 0.9rem;
    color: #64748b;
    text-align: center;
  }

  /* ====================================================
     TIPS GRID
  ==================================================== */
  .tips__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 600px) {
    .tips__grid {
      grid-template-columns: 1fr;
    }
  }

  .tip-card {
    background: #fff;
    border-radius: 10px;
    padding: 1.5rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .tip-card ul {
    margin-bottom: 0;
  }

  /* ====================================================
     CTA / INTERNAL LINKS
  ==================================================== */
  .cta-section {
    background: linear-gradient(135deg, #0a2540 0%, #0066cc 100%);
    color: #fff;
  }

  .cta-section h2 {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }

  .cta-section p {
    color: rgba(255, 255, 255, 0.88);
  }

  .cta-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .btn:hover {
    opacity: 0.88;
  }

  .btn--primary {
    background: #fff;
    color: #0066cc;
  }

  .btn--secondary {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.6);
  }
  
    /* ====================================================
     PARKING MAP IMAGE
  ==================================================== */
  .parking-map__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    margin: 1.5rem 0 1rem;
  }

</style>
