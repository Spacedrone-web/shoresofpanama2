<html>
  <head>
    <title>Unit QR Viewer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
      body {
        font-family: Arial, sans-serif;
        text-align: center;
        margin: 0;
        padding: 2rem;
        background: #f5f7fa;
        color: #333;
      }

      h1 {
        font-size: 2rem;
        margin-bottom: 1rem;
        color: #005f99;
      }

      #unitForm input {
        font-size: 1.5rem;
        padding: 12px;
        width: 80%;
        max-width: 300px;
        border-radius: 8px;
        border: 1px solid #ccc;
      }

      #unitForm button {
        margin-top: 1rem;
        font-size: 1.4rem;
        padding: 12px 24px;
        background: #0077cc;
        color: white;
        border: none;
        border-radius: 8px;
      }

      #unitForm button:hover {
        background: #005fa3;
      }

      #qrBox img {
        width: 90%;
        max-width: 500px;
        height: auto;
        border-radius: 12px;
        margin-top: 1rem;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.2);
      }
    </style>
  </head>

  <body>

    <h1>Shores of Panama</h1>
	<h2>Unit QR Viewer</h2>

    <form id="unitForm">
      <input id="unitInput" type="text" placeholder="Enter Unit Number" autofocus>
      <br>
      <button type="submit">Show QR</button>
    </form>

    <div id="qrBox" style="display:none;">
      <h2 id="unitLabel"></h2>
      <img id="qrImage">
      <p>Returning in 20 seconds...</p>
    </div>

    <script>
      const form = document.getElementById("unitForm");
      const input = document.getElementById("unitInput");
      const qrBox = document.getElementById("qrBox");
      const unitLabel = document.getElementById("unitLabel");
      const qrImage = document.getElementById("qrImage");

      form.addEventListener("submit", (e) => {
        e.preventDefault();

        const unit = input.value.trim();
        if (!unit) {
          alert("Please enter a unit number.");
          return;
        }

        const url = `/units/unit${unit}.png`;

        unitLabel.textContent = `Unit ${unit}`;
        qrImage.src = url;

        qrBox.style.display = "block";

        qrImage.onerror = () => {
          window.location.href = "/qr-not-found";
        };

        setTimeout(() => {
          qrBox.style.display = "none";
          input.value = "";
          input.focus();
        }, 20000);
      });
    </script>

  </body>
</html>
